FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 STORAGE_PATH=/data
WORKDIR /app
COPY requirements-storage.txt .
RUN pip install --no-cache-dir -r requirements-storage.txt
COPY storage_node ./storage_node
RUN useradd --create-home --uid 10001 storage && mkdir -p /data && chown storage:storage /data
USER storage
EXPOSE 8000
CMD ["uvicorn", "storage_node.app:app", "--host", "0.0.0.0", "--port", "8000"]

